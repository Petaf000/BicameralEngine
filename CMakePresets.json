{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "X_VCPKG_REGISTRIES_CACHE": "${sourceDir}/out/vcpkg/registries",
        "VCPKG_DEFAULT_BINARY_CACHE": "${sourceDir}/out/vcpkg/archives",
        "VCPKG_DOWNLOADS": "${sourceDir}/out/vcpkg/downloads",
        "VCPKG_KEEP_ENV_VARS": "X_VCPKG_REGISTRIES_CACHE;VCPKG_DEFAULT_BINARY_CACHE;VCPKG_DOWNLOADS"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "debug",
      "displayName": "Debug (D3D12 debug layer + GPU validation)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BICAMERAL_GPU_VALIDATION": "ON" }
    },
    {
      "name": "profile",
      "displayName": "Profile (最適化 + PIX マーカー)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "BICAMERAL_PIX": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "profile", "configurePreset": "profile", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
