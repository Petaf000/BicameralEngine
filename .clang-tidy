# 名前の付け方と、読みにくさ・古い書き方の検出(docs/style.md)。
# VS 2026 の「Clang-Tidy」コード分析がこれを読む。PC では job.py tidy、CI では build ジョブが tools/tidy/run_clang_tidy.py で強制する(T-0011)。
# shaders/ の共通のヘッダ(.hlsli)は HLSL でもコンパイルするので、auto と指示付き初期化子の検査は run_clang_tidy.py が外す。
# bugprone-random-generator-seed は外す: 決まった種で毎回同じ列を出すのがこのプロジェクトの方針(決定性、ADR-0008)。
# readability-braces-around-statements は使わない: if / else の連鎖で 1 行の分岐だけ { } を省く書き方(docs/style.md、
# 2026-09-30 ユーザー決定)を、連鎖のどれかに { } があれば全部に求めるこの検査は許さないため。{ } の付け方は手で守る。
Checks: >
  -*,
  readability-identifier-naming,
  readability-else-after-return,
  readability-function-size,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-auto,
  modernize-loop-convert,
  modernize-use-designated-initializers,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-random-generator-seed,
  performance-*
CheckOptions:
  # --- 型・関数: 大文字始まり(UpperCamel) ---
  - { key: readability-identifier-naming.ClassCase,                value: CamelCase }
  - { key: readability-identifier-naming.StructCase,               value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,                 value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,            value: CamelCase }
  - { key: readability-identifier-naming.FunctionCase,             value: CamelCase }
  - { key: readability-identifier-naming.MethodCase,               value: CamelCase }
  # --- メンバー: class は m_ + 小文字始まり、struct(public)は小文字始まり ---
  - { key: readability-identifier-naming.PrivateMemberPrefix,      value: m_ }
  - { key: readability-identifier-naming.PrivateMemberCase,        value: camelBack }
  - { key: readability-identifier-naming.ProtectedMemberPrefix,    value: m_ }
  - { key: readability-identifier-naming.ProtectedMemberCase,      value: camelBack }
  - { key: readability-identifier-naming.PublicMemberCase,         value: camelBack }
  # --- static メンバー: s_ + 小文字始まり ---
  - { key: readability-identifier-naming.ClassMemberPrefix,        value: s_ }
  - { key: readability-identifier-naming.ClassMemberCase,          value: camelBack }
  # --- 関数の中の物・引数: 小文字始まり(hogeHuga)---
  - { key: readability-identifier-naming.LocalVariableCase,        value: camelBack }
  - { key: readability-identifier-naming.ParameterCase,            value: camelBack }
  - { key: readability-identifier-naming.VariableCase,             value: camelBack }
  # --- 定数・マクロ: 全部大文字のスネークケース(MAX_DEPTH)---
  - { key: readability-identifier-naming.ConstexprVariableCase,    value: UPPER_CASE }
  - { key: readability-identifier-naming.GlobalConstantCase,       value: UPPER_CASE }
  - { key: readability-identifier-naming.StaticConstantCase,       value: UPPER_CASE }
  - { key: readability-identifier-naming.ClassConstantCase,        value: UPPER_CASE }
  # --- enum の値: 大文字始まり(NotSupported)---
  - { key: readability-identifier-naming.EnumConstantCase,         value: CamelCase }
  - { key: readability-identifier-naming.MacroDefinitionCase,      value: UPPER_CASE }
  - { key: readability-identifier-naming.NamespaceCase,            value: lower_case }
  # --- 名前が外から決まっているもの(OS の入口・Agility SDK が探すエクスポート名)は除く ---
  - { key: readability-identifier-naming.FunctionIgnoredRegexp,       value: '^wmain$' }
  - { key: readability-identifier-naming.GlobalConstantIgnoredRegexp, value: '^D3D12SDK.*$' }
  - { key: readability-identifier-naming.VariableIgnoredRegexp,       value: '^D3D12SDK.*$' }
  # 長さを渡している Win32 の文字コード変換は、data() が 0 終端でなくてよい
  - { key: bugprone-suspicious-stringview-data-usage.AllowedCallees, value: 'WideCharToMultiByte;MultiByteToWideChar' }
  # --- 1 関数の大きさの目安(超えたら分ける)---
  # 目安は空行を除いて 50 行。この検査は空行も数えるので、処理の区切りの空行(docs/style.md)のぶん多めにしている
  - { key: readability-function-size.LineThreshold,                value: 70 }
  - { key: readability-function-size.NestingThreshold,             value: 3 }
