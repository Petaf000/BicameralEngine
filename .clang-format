# コードの整形(docs/style.md、ADR-0005)。CI が clang-format 23 で差分を検査する。
# 手元で整形: clang-format -i <ファイル>(VS 2026 は保存時に自動で読む)
BasedOnStyle: Google
Standard: Latest
ColumnLimit: 120               # 日本語コメントは 1 文字 2 桁で数えられるので広め
PenaltyBreakAssignment: 1000       # 宣言・代入は = の直後で改行しない(右辺の引数の中で折り返す)
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4       # public: / private: は行頭
BreakBeforeBraces: Attach      # { は同じ行
NamespaceIndentation: All     # 名前空間の中もインデントする
FixNamespaceComments: true
PointerAlignment: Left
DerivePointerAlignment: false

# 中身が 1 行の if・else・ループは { } を省き、改行して字下げする(同じ行には書かない)。
#   if (x == nullptr)
#       return;
# { } を外すのは手で行う(RemoveBracesLLVM は入れ子の if を 1 文と見て外してしまい、.clang-tidy の
# readability-braces-around-statements と食い違うので使わない)。中身が複数行に渡るなら { } を付ける。
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: Inline
AllowShortCaseLabelsOnASingleLine: true

# 日本語のコメントを勝手に折り返さない(意味の切れ目が壊れる)
ReflowComments: Never
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
InsertNewlineAtEOF: true
